// DAY 12 - RECUSRSION
  // PROBLEM 3  -- Print Fibonacci Series
  
  
  #include <iostream>
  using namespace std;
  
  
  int Fibonacci(int n){
      if (n==0){
          return 0;
      }
      else if (n==1){
          return 1;
      }
      
      return Fibonacci(n-1)+ Fibonacci(n-2);
  }
  
  int main (){
      cout<<Fibonacci(40);
  }


