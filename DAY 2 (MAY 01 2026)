// PROB - 2 [IF-ELSE CONDITION] (VOTING ELIGIBILITY)

#include <iostream>
using namespace std;

int main() {

	int age;
	cin>>age;

	if (age>=18) {
		cout<<"ELIGIBLE FOR VOTE";
	}
	else {
    cout<<" NOT ELIGIBLE FOR VOTE"<<endl;
	}
	return 0;
}

