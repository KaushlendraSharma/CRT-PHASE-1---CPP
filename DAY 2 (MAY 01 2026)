//problem 5 -- Continue statement
//print 1-n and avoid those numbers whoch are not divisible by 3

#include <iostream>
using namespace std;
int main()
{
   int n;
   cin>>n;
   
   for(int i =1; i<=n; i++){
       if(i%3==0){
           continue;
       }
       cout << i << " ";
   }
   cout << "\n";
   return 0;
}

