// PRB 6 -- BREAK STATEMENT
// ADD NUMBER UNTILL WE GET A NEGATIVE NUMBER

#include <iostream>
using namespace std;

int main()
{
     int n;
     int sum = 0;
     while(true){
         cin>>n;
         if(n<0){
             break;
         }
         sum = sum+n;
     }
     cout<<sum;
     return 0;
}

