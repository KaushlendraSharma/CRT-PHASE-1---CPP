#include <iostream>
using namespace std;

bool isPalindrome(string str) {
    int start = 0;
    int end = str.size() - 1;

    while (start < end) {
        if (str[start] != str[end]) {
            return false;
        }
        start++;  // ove inward
        end--;    // move inward
    }
    return true;
}

int main() {
    string str;
    cout << "Enter a string: ";
    cin >> str;

    if (isPalindrome(str)) {
        cout << "Palindrome string" << endl;
    } else {
        cout << "Given string is not a Palindrome" << endl;
    }

    return 0;
}
