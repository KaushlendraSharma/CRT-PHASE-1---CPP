// Tilling problem

#include <iostream>
  using namespace std;
  
int TotalPos (int n ) {
      if(n<4){
          return 1;
      }
      return TotalPos(n-1)+TotalPos(n-4) ;
  }
  
 int main(){
     
     cout<<TotalPos(7);
 }
