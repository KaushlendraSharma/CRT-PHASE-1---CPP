// Problem 1 >> Function Overriding


#include <iostream>
using namespace std;


class Appliance {
    public :
   virtual void turnOn(){
        cout<<"Appliance is starting up....\n";
    }
    //pure virtual function
    virtual void work() = 0 ;
};

class Fan : public Appliance{
    public :
    void turnOn() override{
        cout<<"Fan blades are moving slowly \n";
    }
    void work() override{
    cout<<"Fan is giving me cool air...... \n ,";
    }
};

class Toaster : public Appliance{
    public :
    void work () override{
        cout<<"Toaster is heating up !!!!!!  \n";
    }
};


int main()
{
    Appliance* kitchenApp;
    Fan MyFan;
    
    kitchenApp = &MyFan;
kitchenApp -> turnOn();
kitchenApp -> work();

Toaster myToast;

kitchenApp = &myToast;
kitchenApp->turnOn();
kitchenApp->work();

    return 0;
}

