// Problem 02 >> Constructor overloading

#include <iostream>
using namespace std;



class Rectangle {
    public :
    int lenght;
    int width;
    
    Rectangle(){
        lenght = 1;
        width = 1;
    }
    
     Rectangle(int side){
        lenght = side;
        width = side;
    }
     Rectangle(int side1 , int side2){
        lenght = side1;
        width = side2;
    }
    
    void showArea(){
        cout<<lenght*width<<"\n";
    }
};

int main (){
    Rectangle r1;
    Rectangle r2(5);
    Rectangle r3(5,6);
    
    r1.showArea();
    r2.showArea();
    r3.showArea();
    return 0;
}

