// Inheritance >> 1.1 >> Single Inheritance


#include <iostream>
using namespace std;

class Vehicle{
    public :
    void Start(){
        cout<<"vehicle Starts !"<< "\n";
    }
};

class Car : public Vehicle {
    public :
    void drive(){
        cout<<"Vehicle is running !"<<"\n";
    }
};


int main(){
    Car obj1;
    obj1.drive();
    obj1.Start();
 return 0;
}

