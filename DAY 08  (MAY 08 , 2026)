#include <iostream>
using namespace std;

class Parent1{
    public :
    void Mannu(){
        cout<<"Mannu to pyari Ladki hai";
    }
};

class Parent2{
    public :
    void Mannu(){
        cout<<"Mannu to Sundar bhi hai \n";
    }
    void Kritika(){
        cout<<"Kritika to pagal Ladki hai \n";
    }
};

class Compare : public Parent1 ,  public Parent2{
    
};

int main(){
    
    Compare obj1;
    obj1.Parent2::Mannu();
    obj1.Kritika();
    obj1.Parent1::Mannu();
    return 0;
}
