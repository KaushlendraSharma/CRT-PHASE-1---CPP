// 2.1 -- Compile-time Polymorphism

 #include <iostream>
 using namespace std;
 
 
 class Math{
     
     public :
     void Multiply(){
         cout<<"MULTIPLICATION IS - ";
     
     }
 double Multiply(double x , double y , int z){
     return x*y*z;
 }
 
int Multiply (int x, int y , int z){
     return x*y*z;
 }
 
 int Multiply(int x , int y ){
     return x*y;
 }
 };
 
 int main(){
     
     Math F1;
     F1.Multiply();
     cout<<F1.Multiply(2.6,4.7,5);
     
     return 0;
 }

