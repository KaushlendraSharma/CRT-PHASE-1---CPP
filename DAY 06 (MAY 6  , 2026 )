
//PROBLEM - 01 >> POINTTERS

// Swapping of values of 2 variables

#include <iostream>
using namespace std;

void SwapNumber (int *x , int *y){
    int temp = *x;
    *x= *y;
    *y = temp;
    
}

int main (){
    
    int a ; 
    int b;
    cin>>a;
    cin>>b;
    SwapNumber(&a , &b);
    cout<<a<<" "<<b;
}

