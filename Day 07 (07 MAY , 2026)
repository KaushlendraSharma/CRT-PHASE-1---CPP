// Problem 3 -- Pillars of OOPS
// Encapsulation -- Means we are binding the data (function , variables , data members)into a single unit class called
//class and making some restrictions on this class members , has controlled access by using acces specifiers .


// Data Security || Controlled access over my Data || Validation before accessing the Data || Code Maintainability

#include <iostream>
using namespace std;

class bankAccount {
private :
	int balance;




public :
	void setBalance(int amount)
	{
		if (amount >=0) {
			balance = amount;
		}
		else {
			cout<<"Enter A VALID amount";
		}
	}



public :
	int getBalance () {
		return balance;
	}
};

int main() {
 bankAccount Acc1;
 Acc1.setBalance(50000);
 cout<<Acc1.getBalance();

}
