// PROBLEM 1 -- Print 1 to n (FOR LOOP)




#include <iostream>
using namespace std;


int main(){
    int n;
cout<<"ENTER THE NUMBER OF ITERATIONS : ";
cin>>n;
    for (int i=1 ; i<=n ;i++){
        cout << i <<"\n";
    }
     return 0;
}

