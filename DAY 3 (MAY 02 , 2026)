// PROBLEM 5 -- Print 1 to N (USING DO-WHILE LOOP)



#include <iostream>
using namespace std;


int main(){
    int n;
cout<<"ENTER THE NUMBER OF ITERATIONS : ";
cin>>n;
  int i = 1;
  
    do {
        cout<<i<<"\n";
        i++;
    }
    while(i<=n);
     return 0;
}

