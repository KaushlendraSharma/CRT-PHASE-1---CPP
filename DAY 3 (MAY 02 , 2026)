// PROBLEM 3 -- Print 1 to n (USING WHILE LOOP)



#include <iostream>
using namespace std;


int main(){
    int n;
cout<<"ENTER THE NUMBER OF ITERATIONS : ";
cin>>n;
  int i = 1;
  while (i<=n){
      
      cout<<i<<"\n";
      i++;
  }
    
     return 0;
}

